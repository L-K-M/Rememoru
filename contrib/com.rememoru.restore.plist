<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rememoru.restore</string>
    <!-- Edit the two paths: checkout dir and the snapshot file to restore. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>sleep 60 &amp;&amp; exec "$HOME/Rememoru/rememoru-cli" restore "$HOME/rememoru-snapshot.json" --launch --verbose</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/tmp/rememoru-restore.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rememoru-restore.log</string>
</dict>
</plist>
